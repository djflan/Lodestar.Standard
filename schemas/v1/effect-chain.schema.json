{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lodestar.dev/schemas/v1/effect-chain.schema.json",
  "title": "Lodestar Effect Chain",
  "type": "object",
  "required": ["standardVersion", "kind", "id", "metadata", "slots"],
  "properties": {
    "standardVersion": { "const": "1-draft" },
    "kind": { "const": "effectChain" },
    "id": { "$ref": "identity.schema.json#/$defs/globalId" },
    "metadata": { "$ref": "metadata.schema.json#/$defs/metadata" },
    "slots": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "effectPresetId": { "$ref": "identity.schema.json#/$defs/globalId" },
          "effect": {
            "type": "object",
            "required": ["id", "providerId", "payloadVersion", "payload"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "providerId": { "$ref": "identity.schema.json#/$defs/globalId" },
              "payloadVersion": { "type": "string", "minLength": 1 },
              "resourceIds": { "type": "array", "items": { "$ref": "identity.schema.json#/$defs/globalId" }, "uniqueItems": true },
              "payload": {}
            },
            "additionalProperties": true
          },
          "bypass": { "type": "boolean", "default": false },
          "wetDry": { "type": "number", "minimum": 0, "maximum": 1, "default": 1 },
          "optional": { "type": "boolean", "default": false },
          "fallback": { "const": "bypass" }
        },
        "oneOf": [{ "required": ["effectPresetId"] }, { "required": ["effect"] }],
        "additionalProperties": true
      }
    },
    "extensions": { "type": "object" }
  },
  "additionalProperties": true
}
