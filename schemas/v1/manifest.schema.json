{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lodestar.dev/schemas/v1/manifest.schema.json",
  "title": "Lodestar Package Manifest",
  "type": "object",
  "required": ["standardVersion", "kind", "id", "metadata", "releaseVersion", "assets", "resources"],
  "properties": {
    "standardVersion": { "const": "1-draft" },
    "kind": { "const": "packageManifest" },
    "id": { "$ref": "identity.schema.json#/$defs/globalId" },
    "metadata": { "$ref": "metadata.schema.json#/$defs/metadata" },
    "releaseVersion": { "type": "string", "minLength": 1 },
    "assets": {
      "type": "array",
      "items": {
        "type": "object", "required": ["id", "kind", "path"],
        "properties": {
          "id": { "$ref": "identity.schema.json#/$defs/globalId" },
          "kind": { "enum": ["instrument", "performance", "sourcePreset", "effectPreset", "effectChain"] },
          "path": { "$ref": "#/$defs/safePath" }
        },
        "additionalProperties": false
      }
    },
    "resources": {
      "type": "array",
      "items": {
        "type": "object", "required": ["id"],
        "properties": {
          "id": { "$ref": "identity.schema.json#/$defs/globalId" },
          "mediaType": { "type": "string" },
          "path": { "$ref": "#/$defs/safePath" },
          "external": {
            "type": "object", "required": ["packageId", "resourceId"],
            "properties": { "packageId": { "$ref": "identity.schema.json#/$defs/globalId" }, "resourceId": { "$ref": "identity.schema.json#/$defs/globalId" } },
            "additionalProperties": false
          },
          "hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
        },
        "oneOf": [{ "required": ["path"] }, { "required": ["external"] }],
        "additionalProperties": false
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object", "required": ["packageId", "version", "required"],
        "properties": { "packageId": { "$ref": "identity.schema.json#/$defs/globalId" }, "version": { "type": "string" }, "required": { "type": "boolean" } },
        "additionalProperties": false
      }
    },
    "providers": {
      "type": "array",
      "items": {
        "type": "object", "required": ["providerId", "role", "required"],
        "properties": {
          "providerId": { "$ref": "identity.schema.json#/$defs/globalId" },
          "role": { "enum": ["source", "effect"] },
          "required": { "type": "boolean" },
          "fallback": { "enum": ["silence", "bypass", "omit"] }
        },
        "additionalProperties": false
      }
    },
    "extensions": { "type": "object" }
  },
  "$defs": {
    "safePath": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\u0000).+$" }
  },
  "additionalProperties": true
}
