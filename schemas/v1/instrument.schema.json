{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lodestar.dev/schemas/v1/instrument.schema.json",
  "title": "Lodestar Instrument",
  "type": "object",
  "required": ["standardVersion", "kind", "id", "metadata", "layers", "mixer"],
  "properties": {
    "standardVersion": { "const": "1-draft" },
    "kind": { "const": "instrument" },
    "id": { "$ref": "identity.schema.json#/$defs/globalId" },
    "metadata": { "$ref": "metadata.schema.json#/$defs/metadata" },
    "layers": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "source", "channel"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "source": {
            "type": "object",
            "required": ["id", "providerId", "payloadVersion"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "providerId": { "$ref": "identity.schema.json#/$defs/globalId" },
              "payloadVersion": { "type": "string", "minLength": 1 },
              "presetId": { "$ref": "identity.schema.json#/$defs/globalId" },
              "resourceIds": { "type": "array", "items": { "$ref": "identity.schema.json#/$defs/globalId" }, "uniqueItems": true },
              "payload": {},
              "optional": { "type": "boolean", "default": false },
              "fallback": { "enum": ["silence", "omit"] }
            },
            "additionalProperties": true
          },
          "channel": { "$ref": "routing.schema.json#/$defs/channel" }
        },
        "additionalProperties": true
      }
    },
    "instrumentChannel": { "$ref": "routing.schema.json#/$defs/channel" },
    "mixer": { "allOf": [{ "$ref": "routing.schema.json#/$defs/mixer" }, { "properties": { "scope": { "const": "instrument" } } }] },
    "extensions": { "type": "object" }
  },
  "additionalProperties": true
}
