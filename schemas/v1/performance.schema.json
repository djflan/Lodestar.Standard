{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lodestar.dev/schemas/v1/performance.schema.json",
  "title": "Lodestar Performance",
  "type": "object",
  "required": ["standardVersion", "kind", "id", "metadata", "parts", "mixer", "masterChannel", "outputConfiguration"],
  "properties": {
    "standardVersion": { "const": "1-draft" },
    "kind": { "const": "performance" },
    "id": { "$ref": "identity.schema.json#/$defs/globalId" },
    "metadata": { "$ref": "metadata.schema.json#/$defs/metadata" },
    "parts": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "channel"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "instrumentId": { "$ref": "identity.schema.json#/$defs/globalId" },
          "channel": { "$ref": "routing.schema.json#/$defs/channel" }
        },
        "additionalProperties": true
      }
    },
    "mixer": { "allOf": [{ "$ref": "routing.schema.json#/$defs/mixer" }, { "properties": { "scope": { "const": "performance" } } }] },
    "masterChannel": { "$ref": "routing.schema.json#/$defs/channel" },
    "outputConfiguration": {
      "type": "object",
      "required": ["masterOutputId"],
      "properties": {
        "masterOutputId": { "type": "string", "minLength": 1 },
        "auxiliaryOutputs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "name", "sourceKind", "sourceId"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "name": { "type": "string", "minLength": 1 },
              "sourceKind": { "enum": ["part", "performanceBus"] },
              "sourceId": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": true
    },
    "sequenceTempoState": {
      "type": "object",
      "required": ["timingAuthority", "sequence", "tempoMap"],
      "properties": {
        "timingAuthority": { "enum": ["performance", "host"], "default": "performance" },
        "sequence": {
          "type": "object",
          "required": ["events"],
          "properties": {
            "events": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["beat", "partId", "kind", "payload"],
                "properties": {
                  "beat": { "type": "number", "minimum": 0 },
                  "partId": { "type": "string", "minLength": 1 },
                  "kind": { "enum": ["noteOn", "noteOff", "perNoteExpression", "partControl", "parameterAutomation"] },
                  "payload": { "type": "object" }
                },
                "additionalProperties": true
              }
            }
          },
          "additionalProperties": false
        },
        "tempoMap": {
          "type": "object",
          "required": ["points"],
          "properties": {
            "points": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["beat", "beatsPerMinute"],
                "properties": {
                  "beat": { "type": "number", "minimum": 0 },
                  "beatsPerMinute": { "type": "number", "exclusiveMinimum": 0 }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "extensions": { "type": "object" }
  },
  "additionalProperties": true
}
