{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lodestar.dev/schemas/v1/source-preset.schema.json",
  "title": "Lodestar Source Preset",
  "type": "object",
  "required": ["standardVersion", "kind", "id", "metadata", "providerId", "payloadVersion", "payload"],
  "properties": {
    "standardVersion": { "const": "1-draft" },
    "kind": { "const": "sourcePreset" },
    "id": { "type": "string", "minLength": 1 },
    "metadata": { "$ref": "metadata.schema.json#/$defs/metadata" },
    "providerId": { "type": "string", "minLength": 1 },
    "payloadVersion": { "type": "string", "minLength": 1 },
    "resourceIds": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "payload": {},
    "extensions": { "type": "object" }
  },
  "additionalProperties": true
}
